generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model WalletManagements {
  id              Int      @id @default(autoincrement())
  name            String
  initial_balance Decimal  @db.Decimal(15, 2)
  status          String
  createdAt       DateTime @default(now()) @map("created_at")
  userId          String   @default("system")

  @@map("wallet_managements")
}

model ExpenseCategory {
  id           Int       @id @default(autoincrement())
  name         String
  categoryType String
  budgetLimit  Decimal   @db.Decimal(15, 2)
  status       String
  createdAt    DateTime  @default(now()) @map("created_at")
  userId       String    @default("system")
  expenses     Expense[]

  @@map("expense_categories")
}

model Expense {
  id                  Int             @id @default(autoincrement())
  amount              Decimal         @db.Decimal(15, 2)
  description         String          @db.Text
  transactionDate     DateTime        @map("transaction_date") @db.Date
  createdAt           DateTime        @default(now()) @map("created_at")
  userId              String          @default("system")
  expense_category_id Int
  expenseCategory     ExpenseCategory @relation(fields: [expense_category_id], references: [id])

  @@index([expense_category_id], map: "expense_expense_category_id_fkey")
  @@map("expense")
}

model user {
  id       Int     @id @default(autoincrement())
  email    String  @unique(map: "User_email_key")
  password String
  name     String?
}

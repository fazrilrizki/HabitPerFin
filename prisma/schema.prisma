// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id Int @id @default(autoincrement())
  name String?
  email String @unique
  password String
}

model WalletManagements {
  id Int @id @default(autoincrement())
  name String
  initial_balance Decimal @db.Decimal(15, 2)
  status String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("wallet_managements")
}

model ExpenseCategory {
  id           Int      @id @default(autoincrement())
  name         String
  categoryType String   // "Primer" or "Non-Primer"
  budgetLimit  Decimal  @db.Decimal(15, 2)
  status       String
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("expense_categories")
}

model Expense {
  id            Int     @id @default(autoincrement())
  amount        Decimal @db.Decimal(15, 2)
  description   String  @db.Text
  transactionDate DateTime @db.Date @map("transaction_date")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("expense")
}

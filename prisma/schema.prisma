generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model WalletManagements {
  id                   Int                   @id @default(autoincrement())
  name                 String
  initial_balance      Decimal               @db.Decimal(15, 2)
  status               String
  createdAt            DateTime              @default(now()) @map("created_at")
  userId               String                @default("system")
  remaining_balance    Decimal               @default(0.00) @db.Decimal(15, 2)
  expense              Expense[]
  financialGoalSavings FinancialGoalSaving[]
  incomes              Income[]

  @@map("wallet_managements")
}

model ExpenseCategory {
  id           Int       @id @default(autoincrement())
  name         String
  categoryType String
  budgetLimit  Decimal   @db.Decimal(15, 2)
  status       String
  createdAt    DateTime  @default(now()) @map("created_at")
  userId       String    @default("system")
  expenses     Expense[]

  @@map("expense_categories")
}

model Expense {
  id                   Int                @id @default(autoincrement())
  amount               Decimal            @db.Decimal(15, 2)
  description          String             @db.Text
  transactionDate      DateTime           @map("transaction_date") @db.Date
  createdAt            DateTime           @default(now()) @map("created_at")
  expense_category_id  Int
  userId               String             @default("system")
  wallet_management_id Int?
  expenseCategory      ExpenseCategory    @relation(fields: [expense_category_id], references: [id])
  walletManagements    WalletManagements? @relation(fields: [wallet_management_id], references: [id])

  @@index([expense_category_id], map: "expense_expense_category_id_fkey")
  @@index([wallet_management_id], map: "expense_wallet_management_id_fkey")
  @@map("expense")
}

model Income {
  id                   Int               @id @default(autoincrement())
  amount               Decimal           @db.Decimal(15, 2)
  transactionDate      DateTime          @map("transaction_date") @db.Date
  createdAt            DateTime          @default(now()) @map("created_at")
  userId               String            @default("system")
  wallet_management_id Int
  description          String            @db.Text
  walletManagements    WalletManagements @relation(fields: [wallet_management_id], references: [id])

  @@index([wallet_management_id], map: "income_wallet_management_id_fkey")
  @@map("incomes")
}

model user {
  id       Int     @id @default(autoincrement())
  email    String  @unique(map: "User_email_key")
  password String
  name     String?
}

model FinancialGoal {
  id           Int                   @id @default(autoincrement())
  name         String
  targetAmount Decimal               @db.Decimal(15, 2)
  targetDate   DateTime?             @db.Date
  status       String                @default("active")
  createdAt    DateTime              @default(now()) @map("created_at")
  userId       String                @default("system")
  savings      FinancialGoalSaving[]

  @@map("financial_goals")
}

model FinancialGoalSaving {
  id                   Int               @id @default(autoincrement())
  amount               Decimal           @db.Decimal(15, 2)
  transactionDate      DateTime          @map("transaction_date") @db.Date
  createdAt            DateTime          @default(now()) @map("created_at")
  userId               String            @default("system")
  description          String?           @db.Text
  financial_goal_id    Int
  wallet_management_id Int
  financialGoal        FinancialGoal     @relation(fields: [financial_goal_id], references: [id], onDelete: Cascade)
  walletManagements    WalletManagements @relation(fields: [wallet_management_id], references: [id])

  @@index([financial_goal_id], map: "financial_goal_saving_goal_id_fkey")
  @@index([wallet_management_id], map: "financial_goal_saving_wallet_management_id_fkey")
  @@map("financial_goal_savings")
}

model Habit {
  id          Int        @id @default(autoincrement())
  name        String
  description String?    @db.Text
  frequency   String     @default("daily")
  status      String     @default("active")
  createdAt   DateTime   @default(now()) @map("created_at")
  userId      String     @default("system")
  logs        HabitLog[]

  @@map("habits")
}

model HabitLog {
  id          Int      @id @default(autoincrement())
  habit_id    Int
  date        DateTime @db.Date
  isCompleted Boolean  @default(true)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  userId      String   @default("system")
  habit       Habit    @relation(fields: [habit_id], references: [id], onDelete: Cascade)

  @@unique([habit_id, date])
  @@index([habit_id], map: "habit_log_habit_id_fkey")
  @@map("habit_logs")
}
